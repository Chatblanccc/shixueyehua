<view class="page">
  <view wx:if="{{allowed}}">
    <text class="eyebrow">用心照看，校园的声音</text>
    <text class="page-title">管理中心</text>
    <text class="page-description">让每一次发声、每一份心意，妥善抵达。</text>
    <view class="admin-role"><t-icon name="user" size="30rpx" /><text>{{user.role === 'super_admin' ? '超级管理员' : '学校管理员'}}</text></view>
    <view class="section-heading"><text class="section-title">内容管理</text></view>
    <view class="card admin-list">
      <button class="admin-row" data-route="audio-create" bindtap="onNavigate"><view><t-icon name="sound" size="38rpx" /><text>发布夜话</text></view><t-icon name="chevron-right" size="30rpx" /></button>
      <button class="admin-row" data-route="audio-manage" bindtap="onNavigate"><view><t-icon name="folder" size="38rpx" /><text>音频管理</text></view><t-icon name="chevron-right" size="30rpx" /></button>
      <button class="admin-row" data-route="letter-review" bindtap="onNavigate"><view><t-icon name="mail" size="38rpx" /><text>家书审核</text></view><t-icon name="chevron-right" size="30rpx" /></button>
    </view>
    <view class="section-heading"><text class="section-title">校园管理</text></view>
    <view class="card admin-list">
      <button class="admin-row" data-route="class-manage" bindtap="onNavigate"><view><t-icon name="home" size="38rpx" /><text>班级管理</text></view><t-icon name="chevron-right" size="30rpx" /></button>
      <button wx:if="{{user.role === 'super_admin'}}" class="admin-row" data-route="admin-manage" bindtap="onNavigate"><view><t-icon name="user" size="38rpx" /><text>管理员管理</text></view><t-icon name="chevron-right" size="30rpx" /></button>
      <button class="admin-row" data-route="settings" bindtap="onNavigate"><view><t-icon name="setting" size="38rpx" /><text>系统设置</text></view><t-icon name="chevron-right" size="30rpx" /></button>
    </view>
    <view class="notice">夜话支持草稿、发布和下架。家书审核与校园管理将在后续阶段开放。</view>
    <view wx:if="{{permissionMessage}}" class="notice">{{permissionMessage}}</view>
    <t-button theme="default" variant="outline" size="large" block bind:tap="onRefreshPermission">重新核验权限</t-button>
  </view>
  <view wx:else>
    <empty-state icon="lock-on" title="{{checking ? '正在核验管理权限' : '需要管理权限'}}" description="{{permissionMessage || '此页面仅向已授权的管理员开放。'}}" />
    <t-button theme="default" variant="outline" size="large" block bind:tap="onReturn">返回我的</t-button>
  </view>
</view>
