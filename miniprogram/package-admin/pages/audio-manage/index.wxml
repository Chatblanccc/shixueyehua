<view class="page">
  <view wx:if="{{allowed}}">
    <text class="eyebrow">校园管理</text>
    <text class="page-title">音频管理</text>
    <text class="page-description">珍藏每一次校园发声</text>
    <view class="card admin-placeholder"><empty-state icon="sound" title="功能正在准备中" description="发布、下架和音频管理即将开放。" /></view>
  </view>
  <view wx:else>
    <empty-state icon="lock-on" title="需要管理权限" description="此页面仅向已授权的管理员开放。" />
    <t-button theme="default" variant="outline" size="large" block bind:tap="onReturn">返回我的</t-button>
  </view>
</view>
