.form-card {
  padding: 30rpx;
  margin: 24rpx 0;
}
.field-label,
.section-title,
.caption,
.file-label {
  display: block;
  margin-bottom: 18rpx;
}
.field-label {
  margin-top: 22rpx;
  color: #213c49;
  font-weight: 600;
}
input,
textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  background: #f7f5f0;
  border-radius: 12rpx;
  min-height: 84rpx;
}
textarea {
  min-height: 160rpx;
}
label {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}
t-button {
  display: block;
  margin-top: 18rpx;
}
.inline-actions {
  display: flex;
  gap: 20rpx;
}
.cover-preview {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
}
.file-label {
  overflow-wrap: anywhere;
  color: #52656b;
}
