<view wx:if="{{isOnboarded || previewMode}}" class="page detail-page">
  <view wx:if="{{localExperience}}" class="preview-tag">本地体验 · 可收听与保存进度，锁屏播放需正式环境验证</view>
  <view wx:if="{{previewMode}}" class="preview-tag">页面预览 · 尚未连接学校</view>
  <view wx:if="{{detail.loading}}" class="audio-skeleton"><view class="skeleton-cover"></view><view class="skeleton-line"></view><view class="skeleton-line short"></view><t-loading theme="circular" text="正在带来这期夜话…" /></view>
  <view wx:elif="{{detail.errorMessage}}" class="card audio-empty"><empty-state icon="{{detail.unavailable ? 'sound' : 'error-circle'}}" title="{{detail.unavailable ? '这期夜话暂时无法收听' : '这次没能连接上'}}" description="{{detail.errorMessage}}" /><view class="action-stack"><view><t-button custom-style="width:100%;margin-left:0;margin-right:0" theme="primary" block bind:tap="onRetry">重新查看</t-button></view><view><t-button custom-style="width:100%;margin-left:0;margin-right:0" theme="default" block bind:tap="onGoNightTalk">返回夜话</t-button></view></view></view>
  <block wx:elif="{{detail.audio}}">
    <view class="detail-cover"><view class="detail-default"><view class="detail-moon"></view><text class="detail-cover-label">实 学 夜 话</text><text class="detail-cover-word">听</text><text class="detail-cover-note">声音有温度 · 成长有回响</text></view><image wx:if="{{detail.audio.coverUrl && !failedCover}}" src="{{detail.audio.coverUrl}}" mode="aspectFill" binderror="onCoverError" /></view>
    <view class="detail-heading"><text class="eyebrow">一段声音，一份陪伴</text><text class="detail-title">{{detail.audio.title}}</text><text class="detail-speaker">{{detail.audio.speakerName}}<text wx:if="{{detail.audio.speakerTitle}}"> · {{detail.audio.speakerTitle}}</text></text><text class="audio-meta">{{detail.audio.dateLabel}} · {{detail.audio.durationLabel}}</text></view>
    <view class="player-panel">
      <text class="player-caption">{{playerState.audioId === detail.audio._id ? playerState.status === 'playing' ? '正在收听' : playerState.status === 'loading' ? '正在连接声音…' : playerState.status === 'ended' ? '这一期，听完了' : '停一停，等你回来' : detail.audio.progressLabel}}</text>
      <slider id="audio-seek" min="0" max="{{detail.audio.duration}}" step="1" value="{{playerState.audioId === detail.audio._id ? playerState.currentTime : detail.audio.progress ? detail.audio.progress.currentTime : 0}}" disabled="{{playerState.audioId !== detail.audio._id || playerState.status === 'loading'}}" activeColor="#aa8550" backgroundColor="#e6e7de" block-color="#213c49" block-size="18" bindchange="onSeek" />
      <view class="player-times"><text>{{playerState.audioId === detail.audio._id ? playerState.currentTimeLabel : detail.audio.currentTimeLabel}}</text><text>{{detail.audio.durationLabel}}</text></view>
      <view class="transport-controls"><button class="skip-button" disabled="{{playerState.audioId !== detail.audio._id || playerState.status === 'loading'}}" bindtap="onBack15" aria-label="后退15秒"><t-icon name="rollback" size="42rpx" /><text>15 秒</text></button><button id="audio-play" class="play-button" disabled="{{playerState.audioId === detail.audio._id && playerState.status === 'loading'}}" bindtap="onPlay" aria-label="{{playerState.audioId === detail.audio._id && playerState.status === 'playing' ? '暂停' : '播放'}}"><t-loading wx:if="{{playerState.audioId === detail.audio._id && playerState.status === 'loading'}}" theme="circular" size="48rpx" /><t-icon wx:else name="{{playerState.audioId === detail.audio._id && playerState.status === 'playing' ? 'pause' : 'play'}}" size="58rpx" /></button><button class="skip-button" disabled="{{playerState.audioId !== detail.audio._id || playerState.status === 'loading'}}" bindtap="onForward15" aria-label="前进15秒"><t-icon name="rollfront" size="42rpx" /><text>15 秒</text></button></view>
      <view class="neighbor-controls"><button class="neighbor-button" disabled="{{!detail.audio.previousAudioId}}" bindtap="onPrevious"><t-icon name="chevron-left" size="28rpx" /><text>上一期</text></button><button class="neighbor-button" disabled="{{!detail.audio.nextAudioId}}" bindtap="onNext"><text>下一期</text><t-icon name="chevron-right" size="28rpx" /></button></view>
      <view wx:if="{{playerState.audioId === detail.audio._id && playerState.errorMessage}}" class="list-error"><text>{{playerState.errorMessage}}</text><t-button theme="default" variant="text" bind:tap="onRetryPlayer">重新连接声音</t-button></view>
      <view wx:if="{{playerState.audioId === detail.audio._id && playerState.syncError}}" class="list-error"><text>{{playerState.syncError}}</text><t-button theme="default" variant="text" bind:tap="onRetryProgress">重试保存进度</t-button></view>
    </view>
    <view class="favorite-action"><t-button id="audio-favorite" custom-style="width:100%;margin-left:0;margin-right:0" theme="default" variant="outline" block loading="{{detail.favoriteLoading}}" disabled="{{detail.favoriteLoading}}" icon="{{detail.audio.favorite ? 'heart-filled' : 'heart'}}" bind:tap="onFavorite">{{detail.audio.favorite ? '已收藏 · 再次点击取消' : '收藏这期夜话'}}</t-button><text wx:if="{{detail.favoriteError}}" class="favorite-error">{{detail.favoriteError}}</text></view>
    <view class="section-heading"><text class="section-title">关于这期夜话</text></view><view class="card introduction"><text>{{detail.audio.description || '有些话，让声音慢慢说给你听。'}}</text></view>
    <mini-player compact="{{true}}" />
  </block>
  <view wx:else class="card audio-empty"><empty-state icon="sound" title="等待一段真实的校园声音" description="云服务启用并加入班级后，就能打开学校发布的音频。当前没有可播放或收藏的节目。" /><t-button id="detail-back-night" custom-style="width:100%;margin-left:0;margin-right:0" theme="default" block bind:tap="onGoNightTalk">返回夜话</t-button></view>
</view>
<view wx:else class="gate"><t-loading theme="circular" text="正在连接校园…" /></view>
