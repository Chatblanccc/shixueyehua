@import '../night-talk/audio-list.wxss';
.detail-cover {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 560rpx;
  border-radius: 26rpx;
}
.detail-cover image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.detail-default {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(125deg, #213c49, #2b4a52);
  color: #d7c299;
}
.detail-moon {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border: 1rpx solid rgba(236, 221, 183, 0.15);
  border-radius: 50%;
}
.detail-cover-label {
  position: relative;
  font-size: 25rpx;
  letter-spacing: 9rpx;
}
.detail-cover-word {
  position: relative;
  margin: 30rpx 0;
  font-size: 132rpx;
  line-height: 1.35;
}
.detail-cover-note {
  position: relative;
  color: #b9c9c6;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}
.detail-heading {
  padding: 36rpx 4rpx 28rpx;
}
.detail-title {
  display: block;
  margin-top: 15rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.6;
  word-break: break-all;
}
.detail-speaker {
  display: block;
  margin-top: 18rpx;
  color: #737e75;
  font-size: 25rpx;
  word-break: break-all;
}
.player-panel {
  padding: 27rpx 26rpx;
  border: 1rpx solid #e8e7df;
  border-radius: 26rpx;
  background: #fff;
}
.player-caption {
  display: block;
  color: #8d7857;
  font-size: 23rpx;
  text-align: center;
}
.player-panel slider {
  margin: 24rpx 3rpx 3rpx;
}
.player-times {
  display: flex;
  justify-content: space-between;
  color: #8a9289;
  font-size: 21rpx;
}
.transport-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  margin: 25rpx 0;
}
.page .skip-button {
  display: flex;
  width: 90rpx;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #213c49;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.7;
}
.page .skip-button[disabled] {
  color: #b9c0b8;
}
.page .play-button {
  display: flex;
  width: 126rpx;
  height: 126rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #213c49;
  color: #f8f4e9;
  line-height: 1;
}
.page .play-button[disabled] {
  background: #ced4d0;
}
.neighbor-controls {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid #eeeee7;
  padding-top: 18rpx;
}
.page .neighbor-button {
  display: flex;
  width: auto;
  align-items: center;
  gap: 9rpx;
  margin: 0;
  padding: 10rpx 14rpx;
  background: transparent;
  color: #66756e;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1.4;
}
.page .neighbor-button[disabled] {
  color: #bdc2b9;
}
.favorite-action {
  margin-top: 28rpx;
}
.favorite-error {
  display: block;
  margin-top: 10rpx;
  color: #985e46;
  font-size: 23rpx;
}
.introduction {
  padding: 30rpx;
  color: #647269;
  font-size: 27rpx;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}
