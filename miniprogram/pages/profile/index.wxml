<view wx:if="{{isOnboarded || previewMode}}" class="page">
  <view wx:if="{{previewMode}}" class="preview-tag">页面预览</view>
  <text class="eyebrow">与自己，相处片刻</text>
  <text class="page-title">我的</text>

  <view class="profile-header">
    <view class="avatar"><t-icon name="user" size="62rpx" /></view>
    <view class="profile-identity">
      <text class="nickname">{{user ? user.nickname : '尚未登录'}}</text>
      <text class="identity-label">{{user.identity === 'student' ? '学生' : user.identity === 'parent' ? '家长' : user.identity === 'teacher' ? '教师' : '等你开启与校园的连接'}}</text>
    </view>
  </view>
  <view wx:if="{{user.status === 'disabled'}}" class="notice">当前账号的投稿和管理功能暂时受限。</view>
  <view wx:if="{{!user}}" class="connect-button"><t-button theme="primary" size="large" block bind:tap="onConnect">连接校园</t-button></view>

  <view class="section-heading"><text class="section-title">我的珍藏</text></view>
  <view class="card menu-list">
    <view class="menu-row"><view class="menu-label"><t-icon name="heart" size="38rpx" /><text>我的收藏</text></view><text class="soon-label">即将开放</text></view>
    <view class="menu-row"><view class="menu-label"><t-icon name="time" size="38rpx" /><text>收听历史</text></view><text class="soon-label">即将开放</text></view>
    <view class="menu-row"><view class="menu-label"><t-icon name="mail" size="38rpx" /><text>我的家书</text></view><text class="soon-label">即将开放</text></view>
  </view>

  <view wx:if="{{isAdmin}}" class="admin-entry">
    <t-button theme="default" size="large" block bind:tap="onOpenAdmin">进入管理中心</t-button>
  </view>
  <view class="about-card">
    <text class="about-name">实学夜话</text>
    <text class="caption">让学校的声音被认真听见，<text class="block-line">让家校之间的表达更加真诚。</text></text>
  </view>
  <view class="page-footnote">听见校园 · 写给家人</view>
</view>
<view wx:else class="gate"><t-loading theme="circular" text="正在连接校园…" /></view>
