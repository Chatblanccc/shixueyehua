@import '../onboarding/avatar.wxss';

.profile-header {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 42rpx 0 16rpx;
}
.avatar {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #e9e5d9;
  color: #8d856f;
}
.profile-header .preset-avatar {
  width: 120rpx;
  height: 120rpx;
  border-width: 6rpx;
  font-size: 54rpx;
}
.profile-identity {
  min-width: 0;
}
.nickname {
  display: block;
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 500;
  word-break: break-all;
}
.identity-label {
  display: block;
  margin-top: 8rpx;
  color: #878a81;
  font-size: 23rpx;
}
.connect-button {
  margin-top: 22rpx;
}
.menu-list {
  padding: 0 30rpx;
}
.menu-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #eeede8;
}
.menu-row:last-child {
  border-bottom: 0;
}
.menu-list .interactive-row {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #fff;
  color: #213c49;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
  text-align: left;
}
.menu-list .class-menu-row {
  padding: 26rpx 0;
}
.menu-label {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 22rpx;
  font-size: 28rpx;
}
.menu-label t-icon {
  flex-shrink: 0;
  color: #aa8550;
}
.menu-label > view {
  min-width: 0;
}
.menu-row > t-icon {
  flex-shrink: 0;
  color: #959b92;
}
.menu-trailing {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  color: #96998f;
  font-size: 23rpx;
}
.current-class-caption {
  display: block;
  margin-top: 8rpx;
  color: #878d83;
  font-size: 22rpx;
  word-break: break-all;
}
.soon-label {
  flex-shrink: 0;
  color: #96998f;
  font-size: 23rpx;
}
.profile-error {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f3ebe4;
  color: #985e46;
  font-size: 23rpx;
}
.profile-error text {
  display: block;
  margin-bottom: 8rpx;
}
.admin-entry {
  margin-top: 30rpx;
}
.about-card {
  margin-top: 58rpx;
  text-align: center;
}
.about-name {
  display: block;
  margin-bottom: 14rpx;
  color: #6d766c;
  font-size: 27rpx;
  letter-spacing: 6rpx;
}
