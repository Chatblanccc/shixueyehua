.writing-page {
  padding: 32rpx 32rpx 260rpx;
}
.writing-heading {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 0 36rpx;
}
.save-state {
  font-size: 22rpx;
  color: #85867f;
}
.writing-paper {
  padding: 36rpx 30rpx 24rpx;
  background: #fffefa;
  border-top: 4rpx solid #c5ac7c;
  box-shadow: 0 10rpx 36rpx #213c4908;
}
.writing-title {
  height: 100rpx;
  font-size: 40rpx;
  font-weight: 500;
  color: #213c49;
}
.writing-recipient {
  padding: 26rpx 0;
  color: #a0845f;
  border-bottom: 1rpx solid #ece7dc;
}
.writing-recipient text {
  margin-left: 12rpx;
}
.writing-content {
  box-sizing: border-box;
  width: 100%;
  min-height: 400rpx;
  padding: 36rpx 0;
  font-size: 32rpx;
  line-height: 1.9;
  color: #34464c;
}
.word-note {
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  color: #85867f;
  text-align: right;
}
.attachments-heading {
  display: flex;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
  font-size: 26rpx;
}
.attachments {
  display: flex;
  gap: 18rpx;
}
.attachment,
.add-attachment {
  width: 196rpx;
  height: 196rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}
.attachment image {
  width: 100%;
  height: 100%;
}
.remove-image {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 20rpx;
  background: #fffefae8;
  line-height: 2;
}
.attachment .remove-image {
  min-width: 0;
  width: auto;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  line-height: 2;
  font-weight: 400;
}
.add-attachment {
  margin: 0;
  background: #eeeae0;
  color: #8d8068;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.6;
  font-size: 24rpx;
}
.add-attachment text:first-child {
  font-size: 48rpx;
  font-weight: 300;
}
.attachments .add-attachment {
  flex: 0 0 196rpx;
  width: 196rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
}
.delivery {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 0;
  margin-top: 18rpx;
  border-bottom: 1rpx solid #e1ded5;
  font-size: 26rpx;
}
.privacy-note,
.local-note {
  display: block;
  font-size: 22rpx;
  color: #85867f;
  line-height: 1.7;
  margin-top: 18rpx;
}
.writing-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f7f5f0f5;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8e4da;
}
.action-row {
  display: flex;
  gap: 20rpx;
}
.action-row button {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.8;
  background: #e9e6df;
  color: #213c49;
}
.action-row .submit-letter {
  background: #213c49;
  color: #fffefa;
}
.form-error {
  display: block;
  color: #a13d2c;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
button::after {
  border: 0;
}
