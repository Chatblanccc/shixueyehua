.my-letters-page {
  padding: 40rpx 36rpx 64rpx;
}
.new-letter {
  margin: 36rpx 0;
  background: #213c49;
  color: #fffefa;
  font-size: 28rpx;
}
.own-letter {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #ded9cc;
}
.letter-status {
  display: block;
  color: #a0845f;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.letter-list-title {
  display: block;
  font-size: 34rpx;
  margin: 18rpx 0;
  color: #213c49;
}
.letter-excerpt {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: #85867f;
  line-height: 1.8;
  font-size: 26rpx;
  margin-bottom: 18rpx;
}
.letter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}
.letter-actions button {
  margin: 0;
  font-size: 22rpx;
  color: #62706d;
  background: #efede6;
}
.empty-letter {
  padding: 80rpx 20rpx;
  color: #85867f;
  text-align: center;
}
.form-error {
  color: #a13d2c;
  font-size: 24rpx;
}
button::after {
  border: 0;
}
