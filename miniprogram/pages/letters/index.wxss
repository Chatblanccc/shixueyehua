.letter-invitation {
  position: relative;
  overflow: hidden;
  margin-top: 38rpx;
  padding: 44rpx 36rpx 34rpx;
  border: 1rpx solid #e5ddcb;
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  background: #f1ebdd;
}
.letter-corner {
  position: absolute;
  top: 0;
  left: 0;
  width: 14rpx;
  height: 100%;
  background: #d8c4a0;
}
.letter-stamp {
  position: absolute;
  top: 36rpx;
  right: 32rpx;
  display: flex;
  width: 76rpx;
  height: 90rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #bfa983;
  color: #ad8a58;
  transform: rotate(8deg);
}
.letter-salutation {
  display: block;
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.letter-thought {
  display: block;
  margin-top: 30rpx;
  font-size: 29rpx;
  line-height: 1.9;
  letter-spacing: 2rpx;
}
.letter-lines {
  margin: 14rpx 0 26rpx;
}
.letter-lines view {
  height: 30rpx;
  border-bottom: 1rpx solid #dcd3c0;
}
.letter-lines view:last-child {
  width: 74%;
}
.letter-signature {
  display: block;
  color: #a0845f;
  font-size: 23rpx;
  text-align: right;
}
.compose-button {
  margin-top: 24rpx;
}
.letter-editor,
.own-letter {
  margin-top: 24rpx;
}
.letter-editor input,
.letter-editor textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #dedbd2;
  font-size: 30rpx;
  line-height: 1.7;
}
.letter-editor textarea {
  min-height: 280rpx;
}
.letter-editor input {
  height: 96rpx;
  padding: 0;
}
.letter-picker {
  padding: 24rpx 0;
  color: #213c49;
}
.letter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.letter-actions button {
  margin: 0;
}
.own-letter text {
  display: block;
  margin-bottom: 12rpx;
}
.letter-error {
  margin-top: 24rpx;
  color: #a13d2c;
}
.letters-home {
  padding: 40rpx 36rpx 80rpx;
}
.home-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mine-entry {
  color: #62706d;
  font-size: 24rpx;
}
.home-title {
  display: block;
  font-size: 62rpx;
  line-height: 1.35;
  letter-spacing: 3rpx;
  font-weight: 500;
  margin-top: 66rpx;
  color: #213c49;
}
.home-subtitle {
  display: block;
  font-size: 28rpx;
  line-height: 1.9;
  color: #85867f;
  margin: 28rpx 0 46rpx;
}
.write-entry {
  margin: 28rpx 0 70rpx;
  background: #213c49;
  color: #fffefa;
  font-size: 28rpx;
  line-height: 3;
  text-align: left;
  padding: 0 30rpx;
}
.write-entry text {
  float: right;
  font-size: 36rpx;
  font-weight: 300;
}
.showcase-heading {
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #ded9cc;
}
.showcase-empty {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 42rpx 0;
  color: #85867f;
  font-size: 26rpx;
}
.write-entry::after {
  border: 0;
}
