@import './avatar.wxss';

.onboarding-page {
  padding-top: 36rpx;
}
.onboarding-page .step-track {
  margin-bottom: 38rpx;
}
.form-loading {
  padding: 80rpx 0;
  text-align: center;
}
.form-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 18rpx;
  font-size: 27rpx;
  font-weight: 500;
}
.field-required {
  color: #aa8550;
  font-size: 21rpx;
  font-weight: 400;
}
.identity-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.identity-options .identity-option {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 22rpx;
  margin: 0;
  padding: 22rpx;
  border: 2rpx solid transparent;
  color: #213c49;
  font-weight: 400;
  line-height: 1.6;
  text-align: left;
}
.identity-option.is-selected {
  border-color: #aa8550;
  background: #fffdf8;
}
.identity-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f4f2eb;
  color: #aa8550;
}
.identity-copy {
  min-width: 0;
  flex: 1;
}
.identity-title {
  display: block;
  font-size: 29rpx;
  font-weight: 500;
}
.identity-copy .caption {
  font-size: 22rpx;
}
.choice-mark {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dadcd5;
  border-radius: 50%;
}
.is-selected .choice-mark {
  border-color: #aa8550;
  background: #aa8550;
  color: #fff;
}
.nickname-field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 26rpx;
}
.nickname-input {
  min-width: 0;
  height: 100rpx;
  flex: 1;
  font-size: 28rpx;
}
.input-placeholder,
.input-count {
  color: #959a94;
}
.input-count {
  font-size: 21rpx;
}
.field-hint {
  display: block;
  margin: 12rpx 4rpx 0;
  color: #81877f;
  font-size: 22rpx;
}
.avatar-options {
  display: flex;
  gap: 18rpx;
}
.avatar-options .avatar-option {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  padding: 22rpx 12rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #fff;
  color: #777c79;
  font-weight: 400;
  line-height: 1.6;
}
.avatar-option.is-selected {
  border-color: #aa8550;
  background: #fffdf8;
  color: #213c49;
}
.avatar-label {
  font-size: 23rpx;
}
.form-error {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #985e46;
  font-size: 24rpx;
}
.form-error t-icon {
  flex-shrink: 0;
  margin-top: 5rpx;
}
