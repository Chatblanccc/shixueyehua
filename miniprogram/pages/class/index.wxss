@import '../onboarding/avatar.wxss';

.class-card {
  margin-top: 40rpx;
  padding: 0 30rpx;
}
.class-card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 0;
}
.class-card-header .preset-avatar {
  width: 92rpx;
  height: 92rpx;
  font-size: 44rpx;
}
.school-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #eef0e9;
  color: #4d695e;
}
.class-card-copy {
  min-width: 0;
  word-break: break-all;
}
.class-card-title {
  display: block;
  margin-bottom: 4rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.class-field {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid #eeede8;
  color: #777c79;
  font-size: 26rpx;
}
.class-field text:first-child {
  flex-shrink: 0;
}
.class-field text:last-child {
  min-width: 0;
  color: #3c4f55;
  text-align: right;
  word-break: break-all;
}
.class-loading {
  padding: 34rpx 0;
  text-align: center;
}
.class-error {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #f3ebe4;
  color: #985e46;
  font-size: 24rpx;
}
.class-error text {
  display: block;
  margin-bottom: 12rpx;
}
.class-guidance {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 30rpx;
  color: #8b8f87;
  font-size: 23rpx;
}
.class-guidance t-icon {
  flex-shrink: 0;
}
