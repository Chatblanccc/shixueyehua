page {
  --color-paper: #f7f5f0;
  --color-surface: #ffffff;
  --color-ink: #213c49;
  --color-muted: #777c79;
  --color-gold: #aa8550;
  --color-line: #e8e6df;
  --td-brand-color: #213c49;
  --td-brand-color-active: #182e38;
  --td-brand-color-disabled: #bbc4c8;
  --td-button-primary-bg-color: #213c49;
  --td-button-primary-border-color: #213c49;
  --td-button-primary-active-bg-color: #182e38;
  --td-button-primary-disabled-bg-color: #bbc4c8;
  --td-button-primary-disabled-border-color: #bbc4c8;
  --td-button-default-color: #213c49;
  --td-button-large-height: 96rpx;
  --td-button-border-radius: 20rpx;
  min-height: 100%;
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
image,
button,
navigator {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  padding: 32rpx 36rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  display: block;
  color: var(--color-gold);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.page-title {
  display: block;
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.page-description {
  display: block;
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.8;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 46rpx 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-note {
  color: var(--color-muted);
  font-size: 22rpx;
}

.card {
  overflow: hidden;
  border: 1rpx solid rgba(33, 60, 73, 0.05);
  border-radius: 26rpx;
  background: var(--color-surface);
}

.caption {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.8;
}

.block-line {
  display: block;
}

.subtle-label {
  color: var(--color-gold);
  font-size: 22rpx;
}

.page-footnote {
  margin-top: 44rpx;
  color: #93958e;
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.preview-tag {
  display: inline-block;
  margin-bottom: 24rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid #d8d6cc;
  border-radius: 8rpx;
  color: #777c79;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.gate {
  display: flex;
  min-height: 60vh;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.action-stack {
  margin-top: 36rpx;
}

.action-stack > view + view {
  margin-top: 20rpx;
}

.notice {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #edece5;
  color: #66716e;
  font-size: 24rpx;
  line-height: 1.8;
}

.step-track {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 64rpx;
  color: #93958e;
  font-size: 22rpx;
}

.step-track .current {
  color: var(--color-ink);
  font-weight: 600;
}

.step-line {
  width: 44rpx;
  height: 1rpx;
  background: #d5d7d0;
}
